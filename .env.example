# ==============================================================================
# El Hana Group - Environment Variables Configuration (.env.example)
# ==============================================================================
# Instructions:
# 1. In Vercel Project Settings -> Environment Variables, add these keys.
# 2. For local server development, copy this file to .env and fill in the values.
# 3. NEVER commit real secret values to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Object Storage (Supabase)
# ------------------------------------------------------------------------------
# Create a free project on https://supabase.com
# Run the SQL migration script: supabase-schema.sql
# Then copy your project credentials from Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co
# Service Role Key (SERVER ONLY - NEVER expose with VITE_ prefix!)
SUPABASE_SERVICE_ROLE_KEY=eyJh......your_service_role_secret_key
# Anon Public Key (optional client/server key)
SUPABASE_ANON_KEY=eyJh......your_anon_public_key

# ------------------------------------------------------------------------------
# 2. Admin Authentication
# ------------------------------------------------------------------------------
# Strong master password for the admin dashboard (e.g. at /admin/bookings or admin modal)
ADMIN_PASSWORD=change_this_to_a_strong_random_password_min_16_chars
# Secret used by the server to cryptographically sign HMAC session tokens (32+ chars)
ADMIN_SESSION_SECRET=generate_a_random_32_char_secret_key_here
# Admin email for notifications / auth identification
ADMIN_EMAIL=admin@elahanasafari.com

# ------------------------------------------------------------------------------
# 3. Owner Notifications (Telegram Bot)
# ------------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram to receive instant booking notifications
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Your personal or group chat ID (get it from @userinfobot or @getidsbot)
TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# 4. Optional Client Configurations
# ------------------------------------------------------------------------------
# Optional API base URL for client fetch requests (defaults to /api on Vercel)
# VITE_API_BASE_URL=/api
